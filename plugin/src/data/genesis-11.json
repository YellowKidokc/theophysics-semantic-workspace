  "segments": [
    { "segment_uuid": "gen-11", "level": "chapter", "parent_uuid": "gen-book", "content": "Genesis 11", "index_in_parent": 10, "book_uuid": "gen-book", "chapter_uuid": "gen-11" },
    { "segment_uuid": "gen-11-p1", "level": "paragraph", "parent_uuid": "gen-11", "content": "", "index_in_parent": 0, "chapter_uuid": "gen-11", "paragraph_uuid": "gen-11-p1" },
    { "segment_uuid": "gen-11-1", "level": "verse", "parent_uuid": "gen-11-p1", "content": "And the whole earth was of one language, and of one speech.", "index_in_parent": 0, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-1", "paragraph_uuid": "gen-11-p1" },
    { "segment_uuid": "gen-11-2", "level": "verse", "parent_uuid": "gen-11-p1", "content": "And it came to pass, as they journeyed from the east, that they found a plain in the land of Shinar; and they dwelt there.", "index_in_parent": 1, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-2", "paragraph_uuid": "gen-11-p1" },
    { "segment_uuid": "gen-11-3", "level": "verse", "parent_uuid": "gen-11-p1", "content": "And they said one to another, Go to, let us make brick, and burn them throughly. And they had brick for stone, and slime had they for morter.", "index_in_parent": 2, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-3", "paragraph_uuid": "gen-11-p1" },
    { "segment_uuid": "gen-11-4", "level": "verse", "parent_uuid": "gen-11-p1", "content": "And they said, Go to, let us build us a city and a tower, whose top may reach unto heaven; and let us make us a name, lest we be scattered abroad upon the face of the whole earth.", "index_in_parent": 3, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-4", "paragraph_uuid": "gen-11-p1" },
    { "segment_uuid": "gen-11-p2", "level": "paragraph", "parent_uuid": "gen-11", "content": "", "index_in_parent": 1, "chapter_uuid": "gen-11", "paragraph_uuid": "gen-11-p2" },
    { "segment_uuid": "gen-11-5", "level": "verse", "parent_uuid": "gen-11-p2", "content": "And the LORD came down to see the city and the tower, which the children of men builded.", "index_in_parent": 0, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-5", "paragraph_uuid": "gen-11-p2" },
    { "segment_uuid": "gen-11-6", "level": "verse", "parent_uuid": "gen-11-p2", "content": "And the LORD said, Behold, the people is one, and they have all one language; and this they begin to do: and now nothing will be restrained from them, which they have imagined to do.", "index_in_parent": 1, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-6", "paragraph_uuid": "gen-11-p2" },
    { "segment_uuid": "gen-11-7", "level": "verse", "parent_uuid": "gen-11-p2", "content": "Go to, let us go down, and there confound their language, that they may not understand one another's speech.", "index_in_parent": 2, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-7", "paragraph_uuid": "gen-11-p2" },
    { "segment_uuid": "gen-11-8", "level": "verse", "parent_uuid": "gen-11-p2", "content": "So the LORD scattered them abroad from thence upon the face of all the earth: and they left off to build the city.", "index_in_parent": 3, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-8", "paragraph_uuid": "gen-11-p2" },
    { "segment_uuid": "gen-11-9", "level": "verse", "parent_uuid": "gen-11-p2", "content": "Therefore is the name of it called Babel; because the LORD did there confound the language of all the earth: and from thence did the LORD scatter them abroad upon the face of all the earth.", "index_in_parent": 4, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-9", "paragraph_uuid": "gen-11-p2" },
    { "segment_uuid": "gen-11-p3", "level": "paragraph", "parent_uuid": "gen-11", "content": "", "index_in_parent": 2, "chapter_uuid": "gen-11", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-10", "level": "verse", "parent_uuid": "gen-11-p3", "content": "These are the generations of Shem: Shem was an hundred years old, and begat Arphaxad two years after the flood:", "index_in_parent": 0, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-10", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-11", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Shem lived after he begat Arphaxad five hundred years, and begat sons and daughters.", "index_in_parent": 1, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-11", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-12", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Arphaxad lived five and thirty years, and begat Salah:", "index_in_parent": 2, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-12", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-13", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Arphaxad lived after he begat Salah four hundred and three years, and begat sons and daughters.", "index_in_parent": 3, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-13", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-14", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Salah lived thirty years, and begat Eber:", "index_in_parent": 4, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-14", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-15", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Salah lived after he begat Eber four hundred and three years, and begat sons and daughters.", "index_in_parent": 5, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-15", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-16", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Eber lived four and thirty years, and begat Peleg:", "index_in_parent": 6, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-16", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-17", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Eber lived after he begat Peleg four hundred and thirty years, and begat sons and daughters.", "index_in_parent": 7, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-17", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-18", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Peleg lived thirty years, and begat Reu:", "index_in_parent": 8, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-18", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-19", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Peleg lived after he begat Reu two hundred and nine years, and begat sons and daughters.", "index_in_parent": 9, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-19", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-20", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Reu lived two and thirty years, and begat Serug:", "index_in_parent": 10, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-20", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-21", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Reu lived after he begat Serug two hundred and seven years, and begat sons and daughters.", "index_in_parent": 11, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-21", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-22", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Serug lived thirty years, and begat Nahor:", "index_in_parent": 12, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-22", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-23", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Serug lived after he begat Nahor two hundred years, and begat sons and daughters.", "index_in_parent": 13, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-23", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-24", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Nahor lived nine and twenty years, and begat Terah:", "index_in_parent": 14, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-24", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-25", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Nahor lived after he begat Terah an hundred and nineteen years, and begat sons and daughters.", "index_in_parent": 15, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-25", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-26", "level": "verse", "parent_uuid": "gen-11-p3", "content": "And Terah lived seventy years, and begat Abram, Nahor, and Haran.", "index_in_parent": 16, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-26", "paragraph_uuid": "gen-11-p3" },
    { "segment_uuid": "gen-11-p4", "level": "paragraph", "parent_uuid": "gen-11", "content": "", "index_in_parent": 3, "chapter_uuid": "gen-11", "paragraph_uuid": "gen-11-p4" },
    { "segment_uuid": "gen-11-27", "level": "verse", "parent_uuid": "gen-11-p4", "content": "Now these are the generations of Terah: Terah begat Abram, Nahor, and Haran; and Haran begat Lot.", "index_in_parent": 0, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-27", "paragraph_uuid": "gen-11-p4" },
    { "segment_uuid": "gen-11-28", "level": "verse", "parent_uuid": "gen-11-p4", "content": "And Haran died before his father Terah in the land of his nativity, in Ur of the Chaldees.", "index_in_parent": 1, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-28", "paragraph_uuid": "gen-11-p4" },
    { "segment_uuid": "gen-11-29", "level": "verse", "parent_uuid": "gen-11-p4", "content": "And Abram and Nahor took them wives: the name of Abram's wife was Sarai; and the name of Nahor's wife, Milcah, the daughter of Haran, the father of Milcah, and the father of Iscah.", "index_in_parent": 2, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-29", "paragraph_uuid": "gen-11-p4" },
    { "segment_uuid": "gen-11-30", "level": "verse", "parent_uuid": "gen-11-p4", "content": "But Sarai was barren; she had no child.", "index_in_parent": 3, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-30", "paragraph_uuid": "gen-11-p4" },
    { "segment_uuid": "gen-11-31", "level": "verse", "parent_uuid": "gen-11-p4", "content": "And Terah took Abram his son, and Lot the son of Haran his son's son, and Sarai his daughter in law, his son Abram's wife; and they went forth with them from Ur of the Chaldees, to go into the land of Canaan; and they came unto Haran, and dwelt there.", "index_in_parent": 4, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-31", "paragraph_uuid": "gen-11-p4" },
    { "segment_uuid": "gen-11-32", "level": "verse", "parent_uuid": "gen-11-p4", "content": "And the days of Terah were two hundred and five years: and Terah died in Haran.", "index_in_parent": 5, "chapter_uuid": "gen-11", "verse_uuid": "gen-11-32", "paragraph_uuid": "gen-11-p4" }
  ],
